# ZANECO Appointments API — Environment Configuration
# Copy this to .env and fill in production values

# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3500

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=1h

# CORS
CORS_ORIGIN=http://localhost:3500

# Database (PostgreSQL)
DATABASE_URL=postgresql://zaneco:secret@localhost:5432/zaneco_appointments

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (SMTP — used by nodemailer for booking confirmations & reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email (SendGrid — fallback)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@zaneco.ph

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
# Booking rate limit: 1 appointment per IP per hour (enforced in production only; NODE_ENV=development bypasses it)

# Logging
LOG_LEVEL=info
